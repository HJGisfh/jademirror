# Web 前端（Vite）使用的后端：python app.py；手机 App 请在本目录执行 python app_mobile.py（读 ../mobile_backend/.env）
PORT=5000
# 浏览器场景一般不必填；仅调试时如需对外提示完整 URL
PUBLIC_API_BASE=

# 必须与前端来源一致（逗号分隔）；默认含本地 Vite
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_REQUIRED=0
AUTH_TOKEN_TTL_HOURS=168
AUTH_DB_PATH=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ALLOW_MOCK=0

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com
QWEN_MODEL=qwen-image-2.0

REQUEST_TIMEOUT=45
REQUEST_MAX_RETRIES=2
RATE_LIMIT_PER_MINUTE=40

HUNYUAN3D_API_URL=
HUNYUAN3D_ENABLE_TEXTURE=0
HUNYUAN3D_OCTREE_RESOLUTION=128
HUNYUAN3D_INFERENCE_STEPS=5

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_ID=doubao-seed3d-2-0-260328

# 火山引擎豆包 TTS（语音合成大模型）：在 https://console.volcengine.com/speech/service 开通后填写
# - VOLC_TTS_API_KEY: 新版控制台「API Key 管理」中的 Key；与 X-Api-Resource-Id 一起用于 WebSocket/HTTP V3（推荐）
# - VOLC_TTS_APPID: 旧版或混用场景：应用 App ID
# - VOLC_TTS_TOKEN: 旧版 Access Token；WebSocket 旧鉴权或作为 X-Api-Access-Key
# - VOLC_TTS_ACCESS_KEY: 可选。Secret Key；未配 VOLC_TTS_API_KEY 时作 X-Api-Access-Key
# - VOLC_TTS_RESOURCE_ID: 可选。强制 X-Api-Resource-Id（如 seed-tts-1.0）；不设则按音色 ID 自动推断
# - VOLC_TTS_USE_WS: 默认 1，优先 wss://openspeech.../api/v3/tts/bidirection（双向流式 V3）
# - VOLC_TTS_WS_FALLBACK_HTTP: 默认 1，WS 失败再试 HTTP V3
# - VOLC_TTS_USE_V3: 默认 1，走 openspeech V3 单向 HTTP；设为 0 跳过 HTTP V3
# - VOLC_TTS_V3_FALLBACK_V1: 默认 1，V3 失败时回退 V1；设为 0 则 V3 失败直接报错
# - VOLC_TTS_CLUSTER: V1 用；默认 volcano_tts；大模型语音用 volcano_icl 或具体集群名
# - VOLC_TTS_VOICE_*: 四种童子声线对应的 voice_type；以下为默认值，可改为你账号开通的音色 ID
VOLC_TTS_APPID=
VOLC_TTS_TOKEN=
# VOLC_TTS_API_KEY=
# VOLC_TTS_USE_WS=1
# VOLC_TTS_WS_FALLBACK_HTTP=1
# VOLC_TTS_ACCESS_KEY=
# VOLC_TTS_RESOURCE_ID=seed-tts-1.0
# VOLC_TTS_USE_V3=1
# VOLC_TTS_V3_FALLBACK_V1=1
VOLC_TTS_CLUSTER=volcano_tts
# 可选：主 cluster 失败时追加尝试，逗号分隔（控制台 FAQ 中的 cluster 与此对齐）
# VOLC_TTS_CLUSTER_FALLBACK=volcano_icl,volcano_tts
# 可选：大模型合成版本，如 seed-tts-1.1（见豆包 HTTP 文档 request.model）
# VOLC_TTS_MODEL=
# default/warm 默认已对调；deep 默认用低沉男声「磁性解说 Morgan」
VOLC_TTS_VOICE_DEFAULT=zh_female_wenroushunv_emo_v2_mars_bigtts
VOLC_TTS_VOICE_WARM=zh_female_wanwanxiaohe_moon_bigtts
VOLC_TTS_VOICE_BRIGHT=zh_female_tianxinxiaomei_emo_v2_mars_bigtts
VOLC_TTS_VOICE_DEEP=zh_male_jieshuonansheng_mars_bigtts

TC_3D_API_KEY=
TC_3D_BASE_URL=https://api.ai3d.cloud.tencent.com

REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=b1b9449a1277e10402781c5d41eb30c0a0683504fb23fab591ca9dfc2aabe1cb

MESHY_API_KEY=
MESHY_BASE_URL=https://api.meshy.ai


